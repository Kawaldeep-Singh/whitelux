# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build and production output
.next/
out/
build/
dist/

# TypeScript build info
*.tsbuildinfo

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env*
!.env.example

# Debug and system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Local media uploads (keep directory structure with .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep
/uploads/
/temp/
coverage/

# OS metadata & Editor directories
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.vercel/
.turbo/

# Root Environment Example
# Copy to server/.env and client/.env.local respectively

# --- SERVER (.env in /server) ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/whitelux
JWT_SECRET=super_secret_jwt_key_whiteluxe_2026_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@whiteluxe.com
ADMIN_PASSWORD=WhiteLuxe@2026!

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=whitelux

# Email Alerts (SMTP or Resend)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="White Luxe Leads <leads@whiteluxe.com>"
ADMIN_ALERT_EMAIL=admin@whiteluxe.com

# --- CLIENT (.env.local in /client) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ==============================================================================
# White Luxe Real Estate - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` or `.env.local`
#    cp .env.example .env.local
# 2. Fill in your MongoDB Atlas connection string and Gmail SMTP credentials.
# 3. DO NOT commit `.env` or `.env.local` to git or GitHub.
# ==============================================================================

NODE_ENV=development
PORT=3000

# Public App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919815202102

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/WhiteluxRealEstate?retryWrites=true&w=majority

# JWT Authentication for Admin Session
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by `npm run seed`)
ADMIN_EMAIL=admin@whiteluxe.com
ADMIN_PASSWORD=WhiteLuxe@2026!

# Nodemailer Lead Email Alerts (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password
EMAIL_FROM="White Luxe Leads <your_email@gmail.com>"
ADMIN_ALERT_EMAIL=your_admin_inbox@gmail.com

# Cloudinary Media Storage (Optional: if empty, files save locally in /public/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=whitelux
